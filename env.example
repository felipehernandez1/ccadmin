# ═══════════════════════════════════════════════════════════════════════════
# CONFIGURACIÓN DE EJEMPLO - CC ADMIN v5.1.0
# 
# COPIA ESTE ARCHIVO A .env Y COMPLETA CON TUS VALORES
# NUNCA VERSIONEES .env (usar .gitignore)
# ═══════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────
# SUPABASE CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────

# URL de tu proyecto Supabase
# Obtener de: https://app.supabase.com → Settings → API
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública de Supabase
# ⚠️ IMPORTANTE: Usar CLAVE PÚBLICA (anon), no la clave de servicio
SUPABASE_KEY=sb_publishable_YOUR_KEY_HERE

# ─────────────────────────────────────────────────────────────────────────
# APP SETTINGS
# ─────────────────────────────────────────────────────────────────────────

# Modo debug (mostrar logs verbose)
DEBUG=false

# Nivel de logging (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO

# Timeout para requests a Supabase (milliseconds)
TIMEOUT_MS=5000

# Número de intentos para sincronización (retry logic)
RETRY_ATTEMPTS=3

# ─────────────────────────────────────────────────────────────────────────
# CONFIGURACIÓN LOCAL (desarrollo)
# ─────────────────────────────────────────────────────────────────────────

# Base URL de la aplicación (para desarrollo local)
BASE_URL=http://localhost:8000

# Puerto del servidor local
SERVER_PORT=8000

# ═════════════════════════════════════════════════════════════════════════════
# 
# INSTRUCCIONES:
# 1. Copia este archivo a .env
# 2. Reemplaza los valores con tus datos
# 3. .env será ignorado por Git (está en .gitignore)
# 4. Nunca subas .env a GitHub
#
# PARA OBTENER TUS VALORES:
# - SUPABASE_URL: https://app.supabase.com → Proyecto → Settings → API
# - SUPABASE_KEY: Usar la clave PÚBLICA (anon key), no la privada
#
# ═════════════════════════════════════════════════════════════════════════════
